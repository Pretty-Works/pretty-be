# 이 파일을 복사해 .env 로 만들고 값을 채운다. (.env 는 git에 올리지 않는다)
#
#   cp .env.example .env
#
# 값이 비어 있는 항목은 반드시 채워야 앱이 뜬다. 기본값이 있는 항목은 생략해도 된다.

# ── DB ─────────────────────────────────────────────
DB_URL=jdbc:mysql://localhost:3306/prettyworks_test?characterEncoding=UTF-8&connectionTimeZone=Asia/Seoul
DB_USERNAME=root
DB_PASSWORD=
# compose.yaml 의 MySQL 비밀번호와 같아야 한다 (로컬 기본: 1234)

# 동시에 도는 쿼리 수 기준. 늘리기 전에 MySQL max_connections(기본 151) 확인.
DB_POOL_SIZE=40
DB_POOL_MIN_IDLE=5

# ── Redis ──────────────────────────────────────────
# 다중 인스턴스 이벤트 전파용. 단일 인스턴스 로컬 개발에서는 없어도 동작한다.
SPRING_DATA_REDIS_HOST=localhost
SPRING_DATA_REDIS_PORT=6379

# ── 시크릿 ─────────────────────────────────────────
# 세 값 모두 랜덤 바이트를 Base64로 인코딩해 만든다. 운영/개발 값을 공유하지 않는다.
#
#   PowerShell
#     $b = [byte[]]::new(64); $rng = [System.Security.Cryptography.RandomNumberGenerator]::Create()
#     $rng.GetBytes($b); $rng.Dispose(); [Convert]::ToBase64String($b)
#
#   bash
#     openssl rand -base64 64 | tr -d '\n'

# 64 byte. 회전하면 발급된 access token이 전부 무효가 된다.
JWT_SECRET_KEY=

# 32 byte. FastAPI → BE 내부 도구 API(/api/internal/agent/**)의 호출자 인증 키.
# pretty-llm 쪽 INTERNAL_API_KEY 와 같은 값이어야 한다 — 한쪽만 바꾸면 연동이 끊긴다.
AGENT_INTERNAL_API_KEY=

# 32 byte. 승인 토큰을 DB에 원문 저장하지 않고 재시작 후 복구하기 위한 HMAC 키.
AGENT_APPROVAL_TOKEN_SECRET=

# ── Agent 서버 ─────────────────────────────────────
# 로컬에서 FastAPI를 함께 띄운 경우의 주소. Docker Compose 안에서는 http://agent:3002
AGENT_SERVER_URL=http://localhost:3002

# 전체 동시 실행 상한(대기 포함).
AGENT_RUN_MAX_ACTIVE_TOTAL=20

# 첨부 제한
AGENT_UPLOAD_ALLOWED_EXTENSIONS=txt,docx,pdf,hwp
AGENT_UPLOAD_MAX_FILES=5
AGENT_UPLOAD_MAX_FILE_BYTES=10485760
AGENT_UPLOAD_MAX_TOTAL_BYTES=26214400

# 에이전트가 사용자를 보낼 수 있는 외부 도메인 화이트리스트
AGENT_EXTERNAL_URL_ALLOWED_ORIGINS=https://accounts.google.com

# ── 웹 ─────────────────────────────────────────────
CORS_ALLOWED_ORIGINS=http://localhost:3000

# HTTPS 배포에서만 true. 로컬 http 개발에서 true면 쿠키가 저장되지 않는다.
AUTH_COOKIE_SECURE=false

# 운영에서는 false
SPRING_JPA_SHOW_SQL=true

TZ=Asia/Seoul
